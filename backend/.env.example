# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file to git.

# Get this at https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=r8_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The origin(s) allowed to call this proxy, comma separated.
# Use * only for local testing. In production, set it to your deployed
# frontend URL, e.g. https://your-username.github.io
ALLOWED_ORIGINS=*

# Port the server listens on (most hosts inject this automatically)
PORT=8787
